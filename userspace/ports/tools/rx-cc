#!/bin/bash
# rx-cc: gcc for Rustux programs, for build systems of their own (NetSurf's
# Makefile): compiles with the Rustux C library's headers and the ports'
# sysroot (as build-ports.sh does), links static Rustux executables (as
# userspace/build.sh links its programs). -lm, -lpthread, -ldl, -lrt and -liconv are
# in the C library itself.
set -e
T=$(cd "$(dirname "$0")" && pwd)
U=$(cd "$T/../.." && pwd)
CC=${RX_HOST_CC:-gcc}
GCCINC=$($CC -print-file-name=include)
SYSROOT=$U/build/sysroot
INC="-ffreestanding -fbuiltin -fno-stack-protector -fno-pie -fno-pic -fno-asynchronous-unwind-tables
     -nostdinc -isystem $GCCINC -isystem $U/libc/include -isystem $SYSROOT/include -D__rustux__"
link=1
args=()
for a in "$@"; do
    case "$a" in
    -c|-S|-E|-M|-MM) link=0 ;;
    esac
    case "$a" in
    -lm|-lpthread|-ldl|-lrt|-lc|-liconv|-pthread|-rdynamic|-fPIC|-fpic|-shared) continue ;;
    esac
    args+=("$a")
done
if [ $link = 0 ]; then
    # shellcheck disable=SC2086
    exec $CC $INC "${args[@]}"
fi
# shellcheck disable=SC2086
exec $CC -static -nostdlib -no-pie -Wl,--build-id=none -Wl,-z,noseparate-code -T "$U/libc/rustux.ld" \
    "$U/build/libc/crt0.o" -L"$SYSROOT/lib" "${args[@]}" "$U/build/libc.a" "$($CC -print-libgcc-file-name)"
