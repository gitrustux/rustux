+# NetSurf on Rustux (2026-11-26, phase W): the framebuffer frontend on
+# libnsfb's Rustica surface (a compositor window), FreeType fonts (Noto),
+# libcurl with mbedTLS; no JavaScript yet (duktape needs nsgenbind)
+override TARGET := framebuffer
+override NETSURF_FB_FRONTEND := rustica
+override NETSURF_FB_FONTLIB := freetype
+override NETSURF_USE_DUKTAPE := NO
+override NETSURF_USE_OPENSSL := NO
+override NETSURF_USE_JPEGXL := NO
+override NETSURF_USE_WEBP := NO
+override NETSURF_USE_VIDEO := NO
+override NETSURF_USE_NSSVG := NO
+override NETSURF_USE_RSVG := NO
