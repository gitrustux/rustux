+override NETSURF_USE_HARU_PDF := NO
+override NETSURF_USE_SANITIZERS := NO
+# An app (org.rustica.browser): the user's choices in its config folder, its
+# resources in the app
+override NETSURF_FB_RESPATH := $${XDG_CONFIG_HOME}/:/apps/org.rustica.browser/share/netsurf
+override NETSURF_FB_FONTPATH := /usr/share/fonts/noto
+override NETSURF_FB_FONT_SANS_SERIF := NotoSans-Regular.ttf
+override NETSURF_FB_FONT_SANS_SERIF_BOLD := NotoSans-Bold.ttf
