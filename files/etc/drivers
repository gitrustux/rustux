# Drivers devmgr starts (step 12, docs/DRIVERS.md). One per line:
#   VENDOR:DEVICE            PROGRAM     (hex IDs, as lspci -n shows them)
#   class=CC[:SS[:PI]]       PROGRAM     (class, subclass, programming interface)
# The first matching line wins. A driver gets the device's address as its
# argument and its device channel as handle PA_USER0.
#
# QEMU's "edu" test device (-device edu): the test driver
1234:11e8   /bin/edu
#
# virtio-blk: QEMU/KVM disks (step 13). 1001 is the transitional device
# QEMU makes by default; 1042 the modern-only one
1af4:1001   /bin/virtio-blk
1af4:1042   /bin/virtio-blk
#
# NVMe disks (step 13): read-only until the installer (step 20)
class=01:08:02  /bin/nvme
#
# USB mass storage, bulk-only (step 13): usb=CLASS:SUBCLASS:PROTOCOL.
# The kernel's xHCI driver sets the device up; devmgr starts the driver
usb=08:06:50    /bin/usb-storage
